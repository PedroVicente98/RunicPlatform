# Local build outputs and dependency caches.
/build*/
/cmake-build-*/
/out/
/.cache/
/CMakeUserPresets.json
/compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Compiler and debugger outputs.
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.dSYM/

# Generated protocol bindings stay outside handwritten sources.
/proto/generated/
/cpp/generated/
/go/generated/

# Go test/coverage artifacts and local multi-module workspaces.
*.test
coverage.out
/go.work
/go.work.sum

# Editor caches; shared settings, tasks, launch files, and extensions remain trackable.
/.clangd/
/.vscode/ipch/
/.vscode/.browse.VC.db*
/.cursor/workspaceStorage/
*.swp
*~
.DS_Store
